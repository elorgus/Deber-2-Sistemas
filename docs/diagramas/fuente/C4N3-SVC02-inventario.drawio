        <mxCell id="app" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;TRX-02 · EXTERNA AL MÓDULO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;Capa de Aplicación&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Comandos y consultas de ROL-01&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;y ROL-02.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#edf0f5;strokeColor=#aab8c8;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="240" height="140" as="geometry"/></mxCell>
