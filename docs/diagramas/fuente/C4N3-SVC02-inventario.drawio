        <mxCell id="svc04" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;SVC-04 · OTRO MÓDULO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;Pedidos y Fulfillment&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;PuertoReservasInventario →&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;AdaptadorReservasInventario.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#edf0f5;strokeColor=#aab8c8;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="regmov" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PUERTO DE ENTRADA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;RegistroMovimientos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Recepción, transferencia, ajuste (OPS-01) y&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;salida. Los movimientos son inmutables.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="380" y="220" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="consumer" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;ENTRADA ASÍNCRONA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;ConsumidorIdempotente&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Procesa cada evento una sola vez y actualiza&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;réplicas o activa operaciones.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="gestion" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PUERTO DE ENTRADA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;GestionReservas&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Reservar (todo o nada) y liberar. El&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;disponible nunca es negativo (RNF-CON-01).&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="380" y="620" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="consulta" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PUERTO DE ENTRADA (CONSULTA)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;ConsultaExistencias&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Saldo físico, reservado y disponible por SKU&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;· ubicación · lote.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="380" y="820" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="replicas" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;DATOS DE CONSULTA · SOLO LECTURA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;ReplicaCatalogo y réplicas locales&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Productos y reglas de lote · EVT-01, EVT-02&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;· de SVC-01&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Ubicaciones · EVT-03 · de SVC-01&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;OC pendientes de recepción · EVT-19, EVT-20&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;· de SVC-03&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;No se consulta a SVC-01 ni a SVC-03 en&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;cada operación (PRI-04).&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e8f4f1;strokeColor=#88b5aa;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="780" y="220" width="320" height="340" as="geometry"/></mxCell>
        <mxCell id="politica" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;STRATEGY&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;PoliticaSeleccionLotes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;PoliticaFEFO · PoliticaFIFO&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;FEFO: vence antes primero; a igual fecha,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;recepción más antigua. Sin vencimiento:&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;FIFO.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="780" y="620" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="frame" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PUERTOS DE SALIDA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;Persistencia transaccional&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;TX-01 recepción · TX-02 reserva · TX-03&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;salida: cambio de negocio + evento en outbox,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;todo o nada (PRI-06).&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f6f9fc;strokeColor=#a5bfd7;dashed=1;dashPattern=7 5;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1180" y="220" width="320" height="740" as="geometry"/></mxCell>
        <mxCell id="reposal" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PUERTO DE SALIDA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;RepositorioSaldos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Saldos, lotes y reservas.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1200" y="355" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="repomov" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PUERTO DE SALIDA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;RepositorioMovimientos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Movimientos, recepciones y ajustes.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1200" y="465" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="pubport" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PUERTO DE SALIDA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;PublicadorEventos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Registra el evento dentro de la misma&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;transacción.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1200" y="835" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="detect" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PROCESO PERIÓDICO PROPIO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;Detección de vencimientos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Lote en umbral de días → EVT-12. Lote&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;vencido → estado Vencido y EVT-13.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1180" y="1020" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="schema" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;PROPIEDAD DEL MÓDULO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;Esquema propio de SVC-02&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Saldo: físico, reservado, disponible&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Lote y fecha de vencimiento&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Movimiento (inmutable)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Recepción · Ajuste&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Reserva: Activa, Consumida, Liberada&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Tabla Outbox&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Credencial con permisos solo sobre este&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;esquema (PRI-02).&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e8f4f1;strokeColor=#88b5aa;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1580" y="220" width="320" height="540" as="geometry"/></mxCell>
        <mxCell id="outbox" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;ADAPTADOR DE SALIDA&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;PublicadorOutbox&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Guarda el evento en la tabla Outbox y lo&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;publica en TRX-03 en orden por entidad.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#e5f0fb;strokeColor=#a5bfd7;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1580" y="820" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="brk-out" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;TRX-03 · EXTERNO AL MÓDULO&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;Broker de eventos&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Mismo broker de la entrada,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;dibujado dos veces por claridad.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#edf0f5;strokeColor=#aab8c8;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2000" y="820" width="240" height="140" as="geometry"/></mxCell>
        <mxCell id="outnote" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;EVENTOS PUBLICADOS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;EVT-04 a EVT-13&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;INT-07 · EVT-04, EVT-05&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;INT-20 · EVT-08, EVT-09,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;EVT-05&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Sin INT propio: EVT-06, 07, 10&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;a 13&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f1f5f9;strokeColor=#bccddd;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="2000" y="1020" width="240" height="165" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#405a72&quot;&gt;&lt;b&gt;REGLAS CLAVE DE SVC-02&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot; color=&quot;#172e45&quot;&gt;&lt;b&gt;Invariantes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Disponible = físico − reservado; los lotes Vencido o EnCuarentena no cuentan.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;Reserva todo o nada en el MVP; un movimiento se corrige con un ajuste, nunca se edita.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#24384c&quot;&gt;SVC-04 guarda solo el ID de la reserva y una copia de solo lectura de la asignación.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#f1f5f9;strokeColor=#bccddd;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;spacingRight=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="380" y="1020" width="720" height="140" as="geometry"/></mxCell>
